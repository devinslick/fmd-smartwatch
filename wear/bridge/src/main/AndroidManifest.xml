<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_notif"
        android:theme="@android:style/Theme.Material.Light"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Wear Data Layer: receives command strings from the watch app.
             Advertises the "fmd_bridge" capability (res/values/wear.xml). -->
        <service
            android:name=".FmdWearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.BIND_LISTENER" />
            </intent-filter>
        </service>

        <!-- FMD command results arrive via the command notification's reply action -->
        <receiver android:name=".WearReplyReceiver" android:exported="false" />
    </application>
</manifest>
